{
	"schemaVersion": 1,
	"id": "${modid}",
	"version": "${version}",
	"name": "${name}",
	"description": "A Mod that aims at implementing antialiasing features to Minecraft.",
	"authors": [
		"${author}"
	],
	"contact": {
		"homepage": "",
		"sources": ""
	},
	"license": "${license}",
	"icon": "assets/aamod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "${classpath}.AAMod",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "${classpath}.client.AAModClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"aamod.mixins.json",
		{
			"config": "aamod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${fabricversion}",
		"minecraft": "~${mcversion}",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}